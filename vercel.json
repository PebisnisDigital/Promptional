{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ig",
      "destination": "/api/public-previews?ig=catalog"
    },
    {
      "source": "/ig/:bp",
      "destination": "/api/public-previews?ig=prompt&bp=:bp"
    },
    {
      "source": "/member",
      "destination": "/member.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    }
  ],
  "redirects": [
    {
      "source": "/beli-premium",
      "has": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "destination": "/checkout-frame?embed=1",
      "permanent": false
    },
    {
      "source": "/beli-premium.html",
      "has": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "destination": "/checkout-frame?embed=1",
      "permanent": false
    },
    {
      "source": "/beli-premium",
      "destination": "/#daftar",
      "permanent": false
    },
    {
      "source": "/beli-premium.html",
      "destination": "/#daftar",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "badaiprompt.vercel.app"
        }
      ],
      "destination": "https://promptional.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "badaiprompt.vercel.app"
        }
      ],
      "destination": "https://promptional.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/member-area",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/member-area.html",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/member.html",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/akses",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/akses.html",
      "destination": "/member",
      "permanent": false
    }
  ]
}
